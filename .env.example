# Absolute URL to the CRM API, including the /v1/crm prefix
# (e.g. http://localhost:4000/v1/crm for local dev, or
# https://api.debtconquest.com/v1/crm for a deployment where this app's
# origin differs from the backend's). Unset, src/api/client.ts falls back
# to https://app.debtconquest.com/api/v1/crm - the production domain, not a
# relative path - since a relative path would resolve against whatever
# origin this app happens to be served from.
VITE_API_BASE_URL=
